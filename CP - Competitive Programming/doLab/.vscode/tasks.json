{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "build-cpp",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-g",
                "-Wall",
                "-Wextra",
                "-I${workspaceFolder}",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "args": [
                    "-fdiagnostics-color=always",
                    "-std=c++17",
                    "-g",
                    "-Wall",
                    "-Wextra",
                    "-I${workspaceFolder}",
                    "${file}",
                    "-o",
                    "${fileDirname}/${fileBasenameNoExtension}.exe"
                ]
            }
        }
    ]
}