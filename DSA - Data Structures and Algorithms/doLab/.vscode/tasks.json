{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 生成活动文件", // 修改1：gcc → g++，任务标签
            "command": "/usr/bin/g++", // 修改2：gcc → g++，编译器路径（核心）
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。使用g++编译C++代码" // 修改3：增加说明，可选
        }
    ],
    "version": "2.0.0"
}