{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CodeLLDB 启动",
            "type": "lldb",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopOnEntry": false, // 替换原stopAtEntry（CodeLLDB专属名称）
            "cwd": "${fileDirname}",
            "console": "integratedTerminal", // 替换原externalConsole，指定内置终端
            "preLaunchTask": "C/C++: g++ 生成活动文件"
        }
    ]
}